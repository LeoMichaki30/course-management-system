# Backend only. Replace these fictional values with your own Supabase project settings.
SUPABASE_URL=https://your-project.example.invalid
# Use a server secret key (or a legacy service_role key), never a public key.
# Keep the real value in the root .env; never expose it to the browser or commit it.
SUPABASE_SECRET_KEY=replace-with-your-server-secret

# Optional Docker Compose frontend build setting. This URL is public, not a secret.
# The browser must reach the published backend port; do not use the Docker service name.
VITE_API_URL=http://localhost:3001
